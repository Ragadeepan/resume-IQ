generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password      String
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  resumes       Resume[]
  authTokens    AuthToken[]
}

model Resume {
  id                String    @id @default(uuid())
  userId            String
  fileUrl           String
  cloudinaryPublicId String?
  originalFileName  String
  fileType          String
  rawText           String
  parsedData        Json
  uploadedAt        DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis          Analysis?
  jobMatches        JobMatch[]

  @@index([userId, uploadedAt(sort: Desc)])
}

model Analysis {
  id                   String   @id @default(uuid())
  resumeId             String   @unique
  score                Int
  scoreBreakdown       Json
  strengths            Json
  weaknesses           Json
  suggestions          Json
  keywordReport        Json?
  improvedBullets      Json?
  targetJobDescription String?
  shareToken           String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  resume               Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model JobMatch {
  id             String   @id @default(uuid())
  resumeId       String
  jobTitle       String
  company        String
  location       String?
  applyLink      String
  matchScore     Int
  missingSkills  String[]
  requiredSkills String[]
  metadata       Json?
  createdAt      DateTime @default(now())
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt(sort: Desc)])
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  createdAt DateTime      @default(now())
  usedAt    DateTime?
  revokedAt DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt(sort: Desc)])
  @@index([expiresAt])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_SESSION
}
