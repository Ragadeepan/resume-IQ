{
  "name": "resumeiq",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k -n client,server -c green,cyan \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:test": "node scripts/run-dev-test.mjs",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "npm run prisma:generate --workspace server && npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "smoke:test": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "concurrently": "^9.1.2",
    "docx": "^9.5.1"
  }
}
